# Brain Kit API — copy to .env and adjust
NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://brainkit:brainkit@localhost:5432/brainkit
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
CONSENT_VERSION=v1
# Comma-separated origins for CORS (local preview + Capacitor)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5173,capacitor://localhost,http://localhost
